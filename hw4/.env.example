# Copy this file to .env (in this folder) and fill in your own key.
# Never commit the real .env: it holds your private API key and is listed in .gitignore.

# Required: Portkey API key used to call the OpenAI GPT-5.6 model
PORTKEY_API_KEY=your_portkey_api_key_here

# Optional fallback if you have no Portkey key: a direct OpenAI key
# OPENAI_API_KEY=your_openai_api_key_here

# Optional: override the agent's model (default gpt-5.6-sol)
# CC_AGENT_MODEL=gpt-5.6-sol

# Optional: reasoning effort for the model (default none)
# CC_REASONING_EFFORT=none
